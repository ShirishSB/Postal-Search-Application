<!DOCTYPE html>
<html lang="en">
<head>
    <title>Search Post Office</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-4">

    <h2>Search Indian Postal Locations</h2>

    <form action="/search" method="POST" class="mt-3">
        <div class="form-check">
            <input type="radio" class="form-check-input" name="searchType" value="pincode" required>
            <label class="form-check-label">Search by Pincode</label>
        </div>
        <div class="form-check">
            <input type="radio" class="form-check-input" name="searchType" value="name" required>
            <label class="form-check-label">Search by Name</label>
        </div>
        <input type="text" name="searchQuery" class="form-control my-2" required>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <% if (results.length > 0) { %>
    <h3 class="mt-4">Search Results</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Branch Type</th>
                <th>Delivery Status</th>
                <th>District</th>
                <th>Region</th>
                <th>State</th>
                <th>Favourite</th>
            </tr>
        </thead>
        <tbody>
            <% results.forEach(result => { %>
                <tr>
                    <td><%= result.Name %></td>
                    <td><%= result.BranchType %></td>
                    <td><%= result.DeliveryStatus %></td>
                    <td><%= result.District %></td>
                    <td><%= result.Region %></td>
                    <td><%= result.State %></td>
                    <td>
                        <form action="/search/favourite" method="POST">
                            <input type="hidden" name="name" value="<%= result.Name %>">
                            <input type="hidden" name="branchType" value="<%= result.BranchType %>">
                            <input type="hidden" name="deliveryStatus" value="<%= result.DeliveryStatus %>">
                            <input type="hidden" name="district" value="<%= result.District %>">
                            <input type="hidden" name="region" value="<%= result.Region %>">
                            <input type="hidden" name="state" value="<%= result.State %>">
                            <button type="submit" class="btn btn-success">Favourite</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <% } %>

</body>
</html>
