<!DOCTYPE html>
<html lang="en">
<head>
    <title>Favourite Post Offices</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-4">

    <h2>Favourite Post Offices</h2>

    <table class="table mt-4">
        <thead>
            <tr>
                <th>Name</th>
                <th>Branch Type</th>
                <th>Delivery Status</th>
                <th>District</th>
                <th>Region</th>
                <th>State</th>
            </tr>
        </thead>
        <tbody>
            <% favourites.forEach(fav => { %>
                <tr>
                    <td><%= fav.name %></td>
                    <td><%= fav.branch_type %></td>
                    <td><%= fav.delivery_status %></td>
                    <td><%= fav.district %></td>
                    <td><%= fav.region %></td>
                    <td><%= fav.state %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</body>
</html>
